{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-visibility",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/.well-known/web-bot-auth/*",
			"/api",
			"/api/*",
			"/index.json",
			"/jsonld",
			"/llms-full.txt",
			"/llms.txt",
			"/robots.txt",
			"/*.jsonld",
			"/*.md"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "VISIBILITY_CACHE",
			"id": "236e036e55334c0a8a6636bdcdd088c0"
		}
	],
	"vars": {
		"SITE_NAME": "WhatsMyBiz",
		"SITE_DESCRIPTION": "Stop answering the same WhatsApp questions every day. Your customers get faster answers. You get your time back. WhatsMyBiz builds AI employees that learn your business, speak in your style, and handle enquiries 24/7 — on WhatsApp today, on any platform tomorrow.",
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"ENRICHMENT_CACHE_TTL": "3600",
		"CONTENT_SIGNAL": "ai-input=yes, search=yes, ai-train=no",
		"ENABLE_WEB_BOT_AUTH": "false"
	}
}
